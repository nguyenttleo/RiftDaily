# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
CHALLENGE_SALT=replace-with-another-long-random-string

# Supabase Postgres
# Use the Supabase transaction pooler connection string on port 6543 for hosted deployments.
# Keep this server-only. Do not create NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Riot API is required for verified Match-V5 lane assignments and summoner spells in Elo/Lobby.
# Data Dragon catalog games still work without a key.
RIOT_API_KEY=
RIOT_REGION=na1
RIOT_MATCH_SAMPLE_SIZE=16
RIOT_BUILD_SAMPLE_MATCH_COUNT=64

# Used by /api/cron/generate-daily
CRON_SECRET=replace-with-a-long-random-string

# Creator links shown in the footer/landing page
NEXT_PUBLIC_CREATOR_GITHUB_URL=https://github.com/leots
NEXT_PUBLIC_CREATOR_LINKEDIN_URL=https://www.linkedin.com/in/leonardo-nguyen
